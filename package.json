{
  "name": "burnrate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "server-rs/target/release/burnrate-server.exe",
    "build:server": "cargo build --release --manifest-path server-rs/Cargo.toml",
    "dev:desktop": "vite build && cargo run --manifest-path src-tauri/Cargo.toml",
    "build:desktop": "vite build && npx --yes @tauri-apps/cli@2.12.6 build --config packaging/tauri/bundle.conf.json",
    "build:desktop:bin": "vite build && cargo build --release --manifest-path src-tauri/Cargo.toml",
    "start:node": "node --max-old-space-size=128 --max-semi-space-size=2 server/index.ts",
    "sync:t3": "node scripts/sync-t3.mjs",
    "test": "vitest run",
    "check:ownership": "node scripts/check-ownership.mjs",
    "smoke": "node scripts/smoke/smoke.mjs",
    "smoke:api": "node scripts/smoke/api.mjs",
    "perf": "node scripts/perf-budget.mjs",
    "check:sync": "node scripts/sync-t3.mjs check --strict"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "culori": "^4.0.2",
    "jsonc-parser": "3.3.1",
    "lucide-react": "^0.564.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/culori": "^4.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.7"
  }
}
